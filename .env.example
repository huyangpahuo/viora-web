# 本文件是环境变量模板。复制为 .env.local 并按需修改;.env* 不会被提交到 Git。

# ---- 插件目录(阶段一,可选) ----

# registry 来源(如 huyangpahuo/Viora-plugins)的 registry.json 拉取地址
# REGISTRY_RAW_URL=https://raw.githubusercontent.com/huyangpahuo/Viora-plugins/main/registry.json

# registry 目录缓存后台刷新间隔(秒),默认 300
# REGISTRY_REVALIDATE_SECONDS=300

# 演示预览模式:开启后用仓库内置的本地测试图作为卡片预览,
# 仅用于开发时验证瀑布流布局;页面会出现显著横幅。生产环境必须保持关闭。
# NEXT_PUBLIC_DEMO_PREVIEWS=true

# ---- 账户与站点插件(阶段二) ----

# Supabase 项目设置 → API 中可找到。未配置时站点退化为纯公开画廊。
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# service role key:仅服务端使用,用于读写 github_identities(加密的 GitHub 令牌)。
# 绝对不要以 NEXT_PUBLIC_ 开头命名,不要提交到 Git,不要暴露给客户端。
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# 站点对外地址(OAuth 回调、邮件链接使用)。Vercel 部署时设为正式域名。
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 关联 GitHub(用于自动创建仓库) ----

# 在 GitHub → Settings → Developer settings → OAuth Apps 新建一个 OAuth App,
# Authorization callback URL 填 https://<你的域名>/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# 用于加密存储 GitHub 令牌的 32 字节密钥,生成方式:openssl rand -hex 32
# GITHUB_TOKEN_ENCRYPTION_KEY=
