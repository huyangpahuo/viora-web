# 本文件是环境变量模板。复制为 .env.local 并按需修改;.env* 不会被提交到 Git。

# ---- 阶段一:公开画廊 ----

# 插件目录 registry.json 的拉取地址(默认即官方仓库 raw 地址,一般无需修改)
# REGISTRY_RAW_URL=https://raw.githubusercontent.com/huyangpahuo/Viora-plugins/main/registry.json

# 目录缓存后台刷新间隔(秒),默认 300
# REGISTRY_REVALIDATE_SECONDS=300

# 演示预览模式:开启后用仓库内置的本地测试图作为卡片预览,
# 仅用于开发时验证瀑布流布局;页面会出现显著横幅。生产环境必须保持关闭。
# NEXT_PUBLIC_DEMO_PREVIEWS=true

# ---- 阶段二:认证与反馈(接入 Supabase 时填写,当前未使用) ----

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
